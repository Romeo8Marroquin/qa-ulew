# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never diff or convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.mp4  binary
*.webm binary
*.pdf  binary

# Lockfile: generated, collapse in diffs and reviews.
pnpm-lock.yaml -diff linguist-generated=true
