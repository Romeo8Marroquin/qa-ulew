# Fail loudly if the active Node/pnpm does not match `engines` in package.json.
# Keeps every machine and CI on the same LTS line.
engine-strict=true

# pnpm resolves peer dependencies automatically instead of erroring out.
auto-install-peers=true
strict-peer-dependencies=false

# Keep node_modules strict (no phantom dependencies). Do not enable
# shamefully-hoist unless a tool genuinely cannot resolve its own deps.
shamefully-hoist=false

# Deterministic installs in CI.
resolution-mode=highest
