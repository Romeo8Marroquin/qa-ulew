# What belongs in this repository: source code, project configuration, and the
# project's own documentation in docs/.
#
# What does not: generated output, secrets, machine-local settings, AI assistant
# tooling and instructions, and internal planning notes.

# --- Dependencies ---
node_modules/
.pnpm-store/
.pnpm-debug.log*
.yarn/
.npm/

# --- Build output ---
dist/
.output/
build/
.vercel/
.netlify/

# --- Astro ---
.astro/

# --- Cloudflare ---
.wrangler/
.cloudflare/
.dev.vars
.dev.vars.*
!.dev.vars.example

# --- Environment and secrets ---
# Never commit real credentials. Only the .example templates are tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Caches and generated metadata ---
.cache/
.temp/
.tmp/
.turbo/
.nx/
*.tsbuildinfo
.eslintcache
.stylelintcache

# --- Coverage and test artifacts ---
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/

# --- Editors ---
# .vscode is partially tracked: the shared settings below make Tailwind v4
# IntelliSense and Prettier work correctly for everyone. Personal state is not.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.code-workspace

# --- Operating system ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- AI assistant tooling and instructions ---
# Machine-local working aids, not project documentation. They describe how an
# assistant should behave in this repo, which is not information a contributor
# or reader of the project needs. The project's real conventions are documented
# in docs/architecture.md and docs/design.md, which ARE tracked.
.claude/
CLAUDE.md
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.cursorignore
.windsurf/
.windsurfrules
.aider*
.continue/
.codeium/
.roo/
.roomodes
.cline/
.clinerules
.specstory/
.junie/
.gemini/
.mcp.json
llms.txt
llm.txt
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
.github/chatmodes/

# --- Internal notes and planning ---
# docs/ is the project's documentation and is tracked. Anything internal —
# planning, user stories, estimates, meeting notes, scratch work — stays local.
# Remove an entry here if a document becomes genuinely part of the project.
/internal/
/notes/
/planning/
/scratch/
docs/internal/
docs/private/
docs/drafts/
*.local.md
*.draft.md
TODO.md
NOTES.md
SCRATCH.md
BACKLOG.md
ROADMAP.md
user-stories/
