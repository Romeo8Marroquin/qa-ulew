{
  "name": "qa-ulew",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for Qa Ulew (qa-ulew.tv) — landing page and future Cloudflare services.",
  "license": "MIT",
  "author": "Romeo Ernesto Marroquín Sánchez",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "dev": "pnpm --filter @qa-ulew/web dev",
    "build": "pnpm -r --stream build",
    "preview": "pnpm --filter @qa-ulew/web preview",
    "check": "pnpm -r --stream check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --stream test",
    "test:watch": "pnpm --filter @qa-ulew/web test:watch",
    "test:coverage": "pnpm -r --stream test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test:coverage && pnpm build",
    "clean": "pnpm -r --stream exec rimraf dist .astro && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.71.2"
  }
}
