{
  "name": "@qa-ulew/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Qa Ulew landing page (qa-ulew.tv) — Astro, deployed to Cloudflare Pages.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "astro": "astro",
    "brand:logo": "node ./scripts/prepare-logo.mjs",
    "brand:icons": "node ./scripts/prepare-icons.mjs",
    "brand:og": "node ./scripts/prepare-og.mjs",
    "content:youtube": "node ./scripts/refresh-youtube.mjs",
    "seo:indexnow": "node ./scripts/indexnow.mjs",
    "cf:preview": "wrangler pages dev apps/web/dist --cwd ../..",
    "cf:deploy": "wrangler pages deploy ./dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@iconify-json/lucide": "^1.2.146",
    "@iconify-json/simple-icons": "^1.2.100",
    "@vitest/coverage-v8": "^4.1.12",
    "happy-dom": "^20.14.6",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  }
}
