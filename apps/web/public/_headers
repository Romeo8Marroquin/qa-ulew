# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# Copied verbatim into dist/ at build time. Rules are applied top to bottom.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# Astro fingerprints these filenames, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# NOTE: a Content-Security-Policy is deliberately NOT set yet. The video
# embeds need `frame-src` entries for youtube-nocookie.com and facebook.com,
# and ads (if enabled) would need several more. Add it once those are final —
# see docs/deployment.md.
