---
import Logo from '~/components/Logo.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';

const t = useTranslations(isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);

// Build-time constant — the site is fully prerendered, so this is the year of
// the last deploy. Cheaper and more reliable than a client-side script.
const year = new Date().getFullYear();
---

{
  /*
  One block, no internal divider.

  The copyright line used to sit below a rule of its own, which gave a piece of
  fine print the same structural weight as the brand above it and left a wide
  empty band between them. It is small print — it belongs tucked under the same
  roof, not in its own room.
*/
}
<footer class="border-t border-border bg-bg-subtle">
  <div class="qa-container py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <Logo height={40} />
        <p class="mt-2.5 text-[0.7rem] font-medium tracking-[0.24em] text-fg-subtle uppercase">
          {t('site.tagline')}
        </p>
      </div>

      <SocialLinks size="sm" />
    </div>

    <div
      class="mt-10 flex flex-col gap-1.5 text-sm text-fg-subtle md:flex-row md:items-center md:justify-between"
    >
      <p>{t('footer.copyright', { year })}</p>
      <p>{t('footer.builtWith')}</p>
    </div>
  </div>
</footer>
