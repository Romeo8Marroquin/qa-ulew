---
import SocialLinks from '~/components/SocialLinks.astro';
import { SITE } from '~/config/site';
import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';

const t = useTranslations(isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);

// Build-time constant — the site is fully prerendered, so this is the year of
// the last deploy. Cheaper and more reliable than a client-side script.
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-bg-subtle">
  <div
    class="qa-container flex flex-col gap-8 py-12 md:flex-row md:items-center md:justify-between"
  >
    <div class="space-y-2">
      <p class="text-lg font-semibold text-fg">{SITE.name}</p>
      <p class="max-w-sm text-sm text-fg-muted">{t('site.tagline')}</p>
    </div>

    <SocialLinks size="sm" />
  </div>

  <div class="border-t border-border">
    <div
      class="qa-container flex flex-col gap-2 py-6 text-sm text-fg-subtle md:flex-row md:items-center md:justify-between"
    >
      <p>{t('footer.copyright', { year })}</p>
      <p>{t('footer.builtWith')}</p>
    </div>
  </div>
</footer>
