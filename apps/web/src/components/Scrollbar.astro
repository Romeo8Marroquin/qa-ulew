---
/**
 * Overlay scrollbar.
 *
 * WHY THIS EXISTS
 *
 * Windows Chromium uses *classic* scrollbars: they occupy a gutter outside the
 * layout viewport, so page content never paints underneath them. A transparent
 * `::-webkit-scrollbar-track` therefore does not reveal the page — it reveals
 * the page BACKGROUND, which over a full-bleed photograph reads as a solid
 * strip cutting down the edge of the image. No amount of CSS fixes that,
 * because the scrollbar is not over the content in the first place.
 *
 * Native scrollbars also cannot fade, cannot respond to pointer proximity, and
 * cannot animate their width — all of which are wanted here.
 *
 * So the native bar is hidden and this one is drawn on top of the page.
 *
 * SAFEGUARD: the native scrollbar is only hidden once this script has run and
 * set `data-custom-scrollbar` on <html>. If the script fails or never loads,
 * the normal scrollbar stays exactly where it was — the page is never left
 * without a way to see or drag the scroll position.
 *
 * Mounted only for fine pointers. Touch platforms already draw transient
 * overlay scrollbars that behave correctly, and a mouse-shaped affordance is
 * wrong on a finger-driven surface.
 */
---

<div class="qa-scrollbar" aria-hidden="true" data-scrollbar hidden>
  <div class="qa-scrollbar-thumb" data-scrollbar-thumb></div>
</div>

<style>
  .qa-scrollbar {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    width: 14px;
    /* The track never swallows clicks; only the thumb is interactive. */
    pointer-events: none;
  }

  .qa-scrollbar-thumb {
    position: absolute;
    right: 4px;
    width: 4px;
    border-radius: 999px;
    background-color: var(--qa-scroll-thumb);
    opacity: 0;
    pointer-events: auto;
    cursor: pointer;
    transition:
      opacity 320ms var(--qa-ease),
      width 180ms var(--qa-ease),
      right 180ms var(--qa-ease),
      background-color 180ms var(--qa-ease);
  }

  /*
   * TWO proximity zones, deliberately separate:
   *
   *   data-visible  the pointer is somewhere near the right edge, or the page
   *                 is scrolling. The thumb appears — thin.
   *   data-hot      the pointer is close to THE THUMB specifically. Only then
   *                 does it thicken.
   *
   * One combined zone meant drifting anywhere near the edge inflated the bar,
   * which felt like the interface lunging at the cursor.
   */
  .qa-scrollbar[data-visible] .qa-scrollbar-thumb {
    opacity: 1;
  }

  .qa-scrollbar[data-hot] .qa-scrollbar-thumb,
  .qa-scrollbar[data-dragging] .qa-scrollbar-thumb,
  .qa-scrollbar-thumb:hover {
    width: 7px;
    right: 3px;
    background-color: var(--qa-scroll-thumb-hover);
  }

  /* Approaching a hidden thumb from the side fades it in and thickens it in
   * one movement, because both states arrive together. */
  .qa-scrollbar[data-hot] .qa-scrollbar-thumb {
    opacity: 1;
  }

  .qa-scrollbar[data-dragging] .qa-scrollbar-thumb {
    background-color: var(--qa-fg);
    cursor: grabbing;
  }

  /* Someone who asked for less motion should not have UI appearing and
   * vanishing as they move. Keep it present and static. */
  @media (prefers-reduced-motion: reduce) {
    .qa-scrollbar-thumb {
      opacity: 1;
      transition: none;
    }
  }

  /*
   * Forced colours: the thumb is painted from a token with alpha, and the
   * native bar this replaces is already hidden by then — so if the thumb does
   * not survive the palette switch the page has no visible scroll position at
   * all. `forced-color-adjust: none` keeps our geometry while `CanvasText`
   * supplies a colour from the user's own scheme.
   *
   * It also stops fading, for the same reason `prefers-reduced-motion` does:
   * a high-contrast theme is chosen to make interface parts easy to find, and
   * one that appears only on approach is not.
   */
  @media (forced-colors: active) {
    .qa-scrollbar-thumb {
      forced-color-adjust: none;
      background-color: CanvasText;
      opacity: 1;
    }
  }
</style>

<script>
  import '~/scripts/scrollbar';
</script>
