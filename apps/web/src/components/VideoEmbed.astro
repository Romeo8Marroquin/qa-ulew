---
/**
 * Privacy-friendly, performance-friendly video embed ("facade" pattern).
 *
 * Nothing from YouTube or Facebook is loaded on page load — we render a poster
 * image and a play button. The real iframe is injected only after the user
 * clicks. That keeps the landing fast (a stock YouTube embed costs ~1 MB of
 * third-party JS per video) and avoids setting third-party cookies before
 * consent.
 *
 * `cloudflare-stream` is supported here already, so migrating a video off
 * YouTube later is a one-line data change in `config/site.ts`.
 *
 * A tile can also be rendered as a **link** rather than a facade, when the
 * platform will not let us embed the video at all — see `embeddable` below.
 * The two variants are deliberately the same markup up to the overlay, because
 * `scripts/video-feed.ts` clones one of each from a <template> when the feed
 * changes after load. Keep them structurally parallel.
 */
import { Icon } from 'astro-icon/components';

import { STREAM, type VideoProvider } from '~/config/site';
import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';

interface Props {
  provider: VideoProvider;
  id: string;
  title: string;
  poster?: string;
  /** Set on the first video of the page so its poster is not lazy-loaded. */
  eager?: boolean;
  /**
   * False when the platform refuses to embed this video, in which case the
   * tile links out instead of opening an iframe that would only render the
   * platform's own error panel inside our layout.
   */
  embeddable?: boolean;
}

const { provider, id, title, poster, eager = false, embeddable = true } = Astro.props;

const t = useTranslations(isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);

const PROVIDER_LABEL: Record<VideoProvider, string> = {
  youtube: 'YouTube',
  facebook: 'Facebook',
  'cloudflare-stream': 'Cloudflare Stream',
};

/** The URL loaded into the iframe on click. `null` = cannot render. */
function embedUrl(): string | null {
  switch (provider) {
    case 'youtube':
      // -nocookie avoids third-party tracking cookies until playback starts.
      return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&modestbranding=1`;
    case 'facebook':
      return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(id)}&show_text=false&autoplay=true`;
    case 'cloudflare-stream':
      return STREAM.customerCode
        ? `https://customer-${STREAM.customerCode}.cloudflarestream.com/${encodeURIComponent(id)}/iframe?autoplay=true`
        : null;
  }
}

/** Public "watch on the original platform" link. */
function canonicalUrl(): string | null {
  switch (provider) {
    case 'youtube':
      return `https://www.youtube.com/watch?v=${encodeURIComponent(id)}`;
    case 'cloudflare-stream':
      return null;
    case 'facebook':
      return id;
  }
}

const src = embedUrl();
const watchUrl = canonicalUrl();

/**
 * A tile with nowhere to send the visitor is worse than no tile. Cloudflare
 * Stream has no public watch page, so a non-embeddable Stream video renders
 * nothing at all rather than a poster that does not respond to a click.
 */
const linkOut = !embeddable && watchUrl !== null;
const render = embeddable ? src !== null : linkOut;

// YouTube exposes a predictable thumbnail; hqdefault always exists, unlike
// maxresdefault which 404s on older or low-resolution uploads.
const posterSrc =
  poster ?? (provider === 'youtube' ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined);

const providerLabel = PROVIDER_LABEL[provider];

/*
 * Thumbnails arrive in full colour from YouTube. Desaturating them keeps the
 * grid consistent with the channel's black-and-white identity; colour returns
 * on hover as a small reward for intent, which also signals the tile is
 * interactive.
 */
const posterClass =
  'h-full w-full object-cover grayscale transition-all duration-500 ease-[var(--ease-brand)] group-hover:scale-[1.03] group-hover:grayscale-0';

/*
 * `qa-focus-inset` draws the focus ring inward. The default ring is offset 3px
 * OUTSIDE the element, and this control is `inset-0` inside a rounded
 * `overflow-hidden` frame — so every pixel of it was clipped and a keyboard
 * user got no ring at all, only the slight background shift below, which is
 * not a focus indicator.
 */
const overlayClass =
  'qa-focus-inset absolute inset-0 flex cursor-pointer items-center justify-center bg-black/25 transition-colors duration-300 group-hover:bg-black/10 focus-visible:bg-black/40';

const badgeClass =
  'flex h-16 w-16 items-center justify-center rounded-full bg-white/95 text-black shadow-lg transition-transform duration-300 ease-[var(--ease-brand)] group-hover:scale-110';
---

{
  render && (
    <figure class="group m-0" data-video-tile data-video-id={id}>
      <div
        class="relative aspect-video w-full overflow-hidden rounded-lg border border-border bg-bg-subtle transition-shadow duration-300 ease-[var(--ease-brand)] group-hover:shadow-lg"
        data-video-facade={embeddable ? '' : undefined}
        data-src={embeddable ? src : undefined}
        data-title={embeddable ? title : undefined}
      >
        {posterSrc ? (
          <img
            src={posterSrc}
            alt=""
            width="1280"
            height="720"
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class={posterClass}
          />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-bg-subtle to-surface-raised" />
        )}

        {embeddable ? (
          <button type="button" class={overlayClass} aria-label={`${t('videos.play')}: ${title}`}>
            <span class={badgeClass}>
              <Icon name="lucide:play" class="ml-1 h-6 w-6" aria-hidden="true" />
            </span>
          </button>
        ) : (
          <a
            href={watchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={overlayClass}
            aria-label={t('a11y.videos.openOnPlatform', { title, provider: providerLabel })}
          >
            <span class={badgeClass}>
              <Icon name="lucide:external-link" class="h-6 w-6" aria-hidden="true" />
            </span>
            <span class="qa-sr-only">{t('a11y.newWindow')}</span>
          </a>
        )}
      </div>

      <figcaption class="mt-4 flex items-start justify-between gap-4">
        <span class="font-medium text-balance text-fg">
          <span data-video-title>{title}</span>
          {/*
            Sighted visitors get the reason the tile behaves differently. The
            overlay link already carries it for a screen reader in its
            aria-label, so this is `aria-hidden` to avoid saying it twice.
          */}
          {!embeddable && (
            <span class="mt-1 block text-sm font-normal text-fg-subtle" aria-hidden="true">
              {t('videos.onlyOnPlatform', { provider: providerLabel })}
            </span>
          )}
        </span>
        {watchUrl && (
          <a
            href={watchUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="qa-link inline-flex shrink-0 items-center gap-1 text-sm whitespace-nowrap text-fg-subtle transition-colors hover:text-fg"
          >
            {t('videos.watchOn', { provider: providerLabel })}
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" aria-hidden="true" />
            {/*
              The arrow glyph is what tells a sighted visitor this leaves the
              site, and it is `aria-hidden` — so without this the warning
              exists for exactly the people who can see it coming anyway.
            */}
            <span class="qa-sr-only">{t('a11y.newWindow')}</span>
          </a>
        )}
      </figcaption>
    </figure>
  )
}

<script>
  import '~/scripts/video-facade';
</script>
