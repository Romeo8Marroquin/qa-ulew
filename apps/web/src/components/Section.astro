---
/**
 * Consistent vertical rhythm and heading structure for every landing section.
 * Keeping this in one place means the eventual design system only has to be
 * applied here, not in six different page fragments.
 */
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  /** Alternate background, for visually separating adjacent sections. */
  muted?: boolean;
  class?: string;
}

const { id, title, subtitle, muted = false, class: className = '' } = Astro.props;
---

<section id={id} class:list={['scroll-mt-20 py-16 md:py-24', muted && 'bg-bg-subtle', className]}>
  <div class="qa-container">
    {
      (title || subtitle) && (
        <header class="mb-10 max-w-2xl">
          {title && (
            <h2 class="font-display text-3xl font-bold tracking-tight text-balance text-fg md:text-4xl">
              {title}
            </h2>
          )}
          {subtitle && <p class="mt-3 text-lg text-pretty text-fg-muted">{subtitle}</p>}
        </header>
      )
    }

    <slot />
  </div>
</section>
