---
/**
 * Consistent vertical rhythm and heading structure for every landing section.
 * Keeping this in one place means the design system only has to be applied
 * here, not in six different page fragments.
 */
import Reveal from '~/components/Reveal.astro';

interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  /** Alternate background, for visually separating adjacent sections. */
  muted?: boolean;
  class?: string;
}

const { id, title, subtitle, muted = false, class: className = '' } = Astro.props;

/**
 * A <section> is NOT a landmark on its own.
 *
 * The HTML-AAM maps it to `region` only when it has an accessible name;
 * without one it is exposed as a generic container, which is why the whole
 * page previously offered a screen reader exactly three landmarks — banner,
 * main, contentinfo — and no way to jump to the videos or the contact details.
 * Pointing `aria-labelledby` at the heading that is already there turns each
 * one into a named region, at the cost of one attribute.
 *
 * Derived from the section's own `id` so it is stable across builds and cannot
 * collide. A section with a title but no id keeps its old behaviour rather
 * than getting a generated id that changes whenever the markup moves.
 */
const headingId = id && title ? `${id}-title` : undefined;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    'scroll-mt-24 py-24 md:py-32',
    muted && 'border-y border-border bg-bg-subtle',
    className,
  ]}
>
  <div class="qa-container">
    {
      (title || subtitle) && (
        <Reveal as="header" class="mb-14 max-w-2xl">
          {title && (
            <h2
              id={headingId}
              class="font-display text-4xl font-semibold tracking-tight text-balance text-fg md:text-5xl"
            >
              {title}
            </h2>
          )}
          {subtitle && <p class="mt-4 text-lg text-pretty text-fg-muted">{subtitle}</p>}
          {/* A short rule under the heading, echoing the ink-on-paper feel. */}
          <span class="mt-8 block h-px w-16 bg-border-strong" aria-hidden="true" />
        </Reveal>
      )
    }

    <slot />
  </div>
</section>
