---
/**
 * Everything that belongs in <head>: metadata, sharing cards, icons and
 * structured data.
 *
 * HOW LINK PREVIEWS ACTUALLY WORK
 *
 * WhatsApp, Messenger, Facebook, LinkedIn, Slack, Discord and Telegram all
 * read Open Graph. X reads its own `twitter:` tags and falls back to Open
 * Graph for anything missing. So Open Graph is the one that has to be complete;
 * the Twitter tags only need to cover what differs.
 *
 * Two details that are skipped surprisingly often and both cause real problems:
 *
 *   - og:image MUST be an absolute URL. Several scrapers, WhatsApp included,
 *     will not resolve a relative one, and the card silently renders blank.
 *   - Declaring og:image:width/height lets a scraper lay out the card before
 *     it has fetched the image. Without them the first share of a link often
 *     shows no picture at all, because the crawler gave up waiting.
 */
import { ANALYTICS, CONTACT, SITE, activeSocialLinks } from '~/config/site';
import { DEFAULT_LOCALE, LOCALE_META, isLocale, type Locale } from '~/i18n/config';
import { alternateLocales, useTranslations } from '~/i18n/utils';
import snapshot from '~/data/youtube-feed.json';

interface Props {
  /** Page title, already translated. Falls back to the site name. */
  title?: string;
  /** Meta description, already translated. */
  description?: string;
  /** Social share image, absolute or root-relative. */
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;

// Branch/preview deploys must never be indexed — otherwise the *.pages.dev URL
// competes with qa-ulew.tv for the same content. Set PUBLIC_ENV=preview on the
// Preview environment in the Cloudflare Pages dashboard.
const isPreview = import.meta.env.PUBLIC_ENV === 'preview';
const blockIndexing = noindex || isPreview;

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
const meta = LOCALE_META[locale];

// Plain hyphens rather than an em dash or a middot: those read as typographic
// affectation in a browser tab, and a title is ordinary language.
const pageTitle = title ? `${title} - ${SITE.name}` : `${SITE.name} - ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');

const origin = Astro.site?.href ?? SITE.url;
const canonical = new URL(Astro.url.pathname, origin);
const socialImage = new URL(image ?? SITE.ogImage, origin);
const alternates = alternateLocales(Astro.url.pathname, origin);

/**
 * Structured data, as a single @graph rather than several loose blocks.
 *
 * A graph lets the nodes reference each other by @id — the site is `publisher`
 * of itself, the videos belong to the organisation — which is what allows a
 * search engine to treat them as one entity instead of unrelated fragments.
 */
const orgId = `${SITE.url}/#organization`;
const siteId = `${SITE.url}/#website`;

const graph: Record<string, unknown>[] = [
  {
    // TelevisionStation rather than plain Organization: it is a LocalBusiness
    // subtype, so the address and phone are meaningful to search engines
    // instead of being ignored as decoration.
    '@type': 'TelevisionStation',
    '@id': orgId,
    name: SITE.name,
    alternateName: 'Qa Ulew TV',
    url: SITE.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/icons/icon-512.png', origin).href,
      width: 512,
      height: 512,
    },
    image: socialImage.href,
    description: t('site.description'),
    slogan: t('site.tagline'),
    email: CONTACT.email,
    telephone: CONTACT.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Sololá',
      addressRegion: 'Sololá',
      postalCode: '07001',
      addressCountry: 'GT',
    },
    areaServed: { '@type': 'Country', name: 'Guatemala' },
    inLanguage: meta.htmlLang,
    // Links the site to the channel's profiles, so they are understood as the
    // same entity rather than unrelated accounts.
    sameAs: activeSocialLinks().map((link) => link.url),
  },
  {
    '@type': 'WebSite',
    '@id': siteId,
    url: SITE.url,
    name: SITE.name,
    description: t('site.description'),
    inLanguage: meta.htmlLang,
    publisher: { '@id': orgId },
  },
];

/**
 * Videos, only on the page that lists them, and only when a description
 * exists — Google requires name, description, thumbnailUrl and uploadDate for
 * a VideoObject, and an incomplete one is worse than none.
 */
interface SnapshotVideo {
  id: string;
  title: string;
  published: string;
  /** Optional: snapshots written before descriptions were captured lack it. */
  description?: string;
}

const videoNodes = (snapshot.videos as SnapshotVideo[])
  .filter((video) => video.description && video.published)
  .slice(0, 6)
  .map((video) => ({
    '@type': 'VideoObject',
    name: video.title,
    description: video.description,
    thumbnailUrl: `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`,
    uploadDate: video.published,
    embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
    url: `https://www.youtube.com/watch?v=${video.id}`,
    publisher: { '@id': orgId },
  }));

if (!title && videoNodes.length > 0) graph.push(...videoNodes);

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={canonical.href} />

{
  /*
  `max-image-preview:large` is what allows Google to show a full-width image
  alongside the result rather than a thumbnail, and the two `-1` values remove
  the default limits on snippet and video preview length. Without them the
  listing is quietly downgraded.
*/
}
{
  blockIndexing ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

{/* Emitted only once a second locale exists. */}
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hrefLang} href={alt.href} />)}

{/* --- Open Graph: WhatsApp, Messenger, Facebook, LinkedIn, Slack, Discord, Telegram --- */}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content={meta.ogLocale} />
<meta property="og:image" content={socialImage.href} />
<meta property="og:image:secure_url" content={socialImage.href} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} - ${t('site.tagline')}`} />
{
  /* Meta's Sharing Debugger reports fb:app_id as a missing *required* property.
     It is not required for the card — that renders without it — only for the
     per-domain analytics inside Meta's dashboard. Emitted once a real app id
     exists; a fabricated one would attribute our traffic to someone else's app. */
}
{SITE.facebookAppId && <meta property="fb:app_id" content={SITE.facebookAppId} />}

{/* --- X / Twitter. Falls back to Open Graph for anything not repeated here. --- */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={socialImage.href} />
<meta name="twitter:image:alt" content={`${SITE.name} - ${t('site.tagline')}`} />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}
{SITE.twitterHandle && <meta name="twitter:creator" content={SITE.twitterHandle} />}

{
  /* --- Icons, generated from the wordmark's Q by scripts/prepare-icons.mjs.
       Apple ignores the manifest, so apple-touch-icon needs its own tag.

       Sizes are declared largest-first because Google picks the icon for the
       search result from these tags, and its guidance is to serve something
       larger than 48x48. A lone 32px favicon — which is what this was — gets
       upscaled next to the result, so a generic globe is the better-looking
       option and Google often keeps showing it. --- */
}
<link rel="icon" href="/icons/favicon-96.png" type="image/png" sizes="96x96" />
<link rel="icon" href="/icons/favicon-48.png" type="image/png" sizes="48x48" />
<link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Matches the browser chrome to the page, per scheme. */}
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf8" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0d0b" />
<meta name="apple-mobile-web-app-title" content={SITE.name} />
<meta name="format-detection" content="telephone=no" />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

{/* Warm up the video hosts only when the user is likely to hit them. */}
<link rel="preconnect" href="https://www.youtube-nocookie.com" crossorigin />
<link rel="dns-prefetch" href="https://i.ytimg.com" />

{/* Privacy-friendly, cookie-free. No script emitted until a token is set. */}
{
  ANALYTICS.cloudflareToken && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token": "${ANALYTICS.cloudflareToken}"}`}
    />
  )
}
