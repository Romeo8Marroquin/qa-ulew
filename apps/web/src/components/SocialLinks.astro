---
/**
 * Renders only the platforms that have a URL configured in `config/site.ts`.
 * Nothing at all is rendered while none are set, so the site never ships a
 * dead link.
 *
 * No circular chips — a ring around every icon turns a row of links into a row
 * of buttons, which they are not.
 *
 * Hover resolves to ink, not to each platform's own colour. Brand colours were
 * tried and pulled: three saturated hues appearing on a strictly monochrome
 * page read as someone else's branding dropped into ours.
 */
import { Icon } from 'astro-icon/components';

import { activeSocialLinks } from '~/config/site';
import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';

interface Props {
  /** `labelled` prints the platform name beside the icon. */
  variant?: 'icon' | 'labelled';
  size?: 'sm' | 'md';
  class?: string;
}

const { variant = 'icon', size = 'md', class: className = '' } = Astro.props;

const t = useTranslations(isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);
const links = activeSocialLinks();

const glyph = size === 'sm' ? 'h-5 w-5' : 'h-6 w-6';
const labelled = variant === 'labelled';
---

{
  links.length > 0 && (
    <ul
      class:list={[
        'flex flex-wrap items-center',
        labelled ? 'gap-x-8 gap-y-3' : size === 'sm' ? 'gap-5' : 'gap-6',
        className,
      ]}
    >
      {links.map((link) => (
        <li>
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('social.followOn', { platform: link.label })}
            class="qa-social inline-flex items-center gap-2.5 py-1 text-fg-muted"
            title={labelled ? undefined : link.label}
          >
            <Icon name={`simple-icons:${link.id}`} class={glyph} aria-hidden="true" />
            {labelled && <span class="text-sm font-medium">{link.label}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  /*
   * The lift is small and the colour shift carries the feedback. Vertical
   * padding keeps the tap target comfortable even though nothing is drawn
   * around the glyph — removing the ring must not shrink the touch area.
   */
  .qa-social {
    transition:
      color var(--qa-dur) var(--qa-ease),
      transform var(--qa-dur) var(--qa-ease);
  }

  .qa-social:hover,
  .qa-social:focus-visible {
    color: var(--qa-fg);
    transform: translateY(-2px);
  }

  .qa-social:active {
    transform: translateY(0);
    transition-duration: 60ms;
  }
</style>
