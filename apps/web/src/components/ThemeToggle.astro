---
/**
 * Light/dark toggle.
 *
 * Default behaviour is "follow the system". Once the user clicks, their choice
 * is stored in localStorage and wins from then on. The no-flash resolution
 * happens in the inline script in BaseLayout, before first paint.
 *
 * Both icons are always in the DOM, stacked, and cross-fade with a short
 * rotation. Swapping `hidden` classes gives an instant, jarring change; the
 * rotation makes the two states feel like one object turning over, which is
 * also a clearer signal that the control did something.
 */
import { Icon } from 'astro-icon/components';

import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';

const t = useTranslations(isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE);
---

<button
  type="button"
  data-theme-toggle
  class="qa-icon-btn qa-theme-toggle"
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
>
  <span class="qa-theme-icons" aria-hidden="true">
    <Icon name="lucide:sun" class="qa-theme-sun h-[1.15rem] w-[1.15rem]" />
    <Icon name="lucide:moon" class="qa-theme-moon h-[1.15rem] w-[1.15rem]" />
  </span>
</button>

<style>
  .qa-theme-icons {
    position: relative;
    display: block;
    height: 1.15rem;
    width: 1.15rem;
  }

  .qa-theme-icons :global(svg) {
    position: absolute;
    inset: 0;
    transition:
      opacity var(--qa-dur) var(--qa-ease),
      transform var(--qa-dur) var(--qa-ease);
  }

  /* Light theme shows the moon: the icon advertises what clicking will DO,
   * not what is currently active. */
  .qa-theme-icons :global(.qa-theme-sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  .qa-theme-icons :global(.qa-theme-moon) {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global([data-theme='dark']) .qa-theme-icons :global(.qa-theme-sun) {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global([data-theme='dark']) .qa-theme-icons :global(.qa-theme-moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .qa-theme-icons :global(svg) {
      transition: opacity 0.01ms;
      transform: none !important;
    }
  }
</style>

<script>
  import '~/scripts/theme-toggle';
</script>
