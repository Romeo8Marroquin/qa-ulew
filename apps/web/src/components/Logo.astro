---
/**
 * The channel wordmark, without its baked-in tagline.
 *
 * The supplied artwork sets "Conectando con nuestra cultura" very small inside
 * the mark. It reads at hero size and collapses into a smudge everywhere else,
 * so `scripts/prepare-logo.mjs` strips it and the tagline is rendered as live
 * text instead — legible at any size, and translatable.
 *
 * Two artworks, black ink and white ink, rather than one file inverted with a
 * CSS filter: the brand ships both, so neither is synthesised. Only one is
 * displayed; `.qa-on-dark` forces the white one regardless of page theme.
 *
 * WHY THE NAME IS ON THE WRAPPER AND NOT ON AN <img>
 *
 * Both artworks are always in the DOM and a token picks which one is
 * `display: block`. An `alt` on one of them is therefore an accessible name
 * that exists in exactly one theme: the black mark carried the alt, so in dark
 * mode — where it is `display: none` and the white one is `aria-hidden` — the
 * footer logo had no name at all and screen readers announced nothing.
 *
 * So both images are decorative, always, and the name lives on the wrapper as
 * `role="img"` + `aria-label`. That is theme-independent by construction: there
 * is no arrangement of the tokens that can make it disappear.
 */
import { Image } from 'astro:assets';

import markBlack from '~/assets/brand/logo-mark-black.png';
import markWhite from '~/assets/brand/logo-mark-white.png';
import fullBlack from '~/assets/brand/logo-full-black.png';
import fullWhite from '~/assets/brand/logo-full-white.png';
import { SITE } from '~/config/site';

interface Props {
  /**
   * `full` is the artwork exactly as supplied, tagline and "TV" included —
   * for the hero, where every detail is legible.
   * `mark` drops both, for the header and footer where they turn to mush.
   */
  variant?: 'full' | 'mark';
  /** Rendered height in px. Ignored when `fluid` is set. */
  height?: number;
  /**
   * Let the caller's own CSS set the height — used by the hero, which scales
   * the mark with `clamp()`. Without this the inline height below would win on
   * specificity and pin it to a fixed size.
   */
  fluid?: boolean;
  class?: string;
  /** Set on above-the-fold marks so they are not lazy-loaded. */
  eager?: boolean;
  /**
   * The mark's accessible name. Pass `''` where the surrounding markup already
   * names it — the hero, whose <h1> carries the name and tagline as live text,
   * and the header link, which has its own `aria-label`. Announcing the
   * wordmark twice in a row is worse than not announcing it.
   */
  alt?: string;
}

const {
  variant = 'mark',
  height = 40,
  fluid = false,
  class: className = '',
  eager = false,
  alt = SITE.name,
} = Astro.props;

const logoBlack = variant === 'full' ? fullBlack : markBlack;
const logoWhite = variant === 'full' ? fullWhite : markWhite;

// The mark is trimmed after the tagline and TV are erased, so the two variants
// have different proportions. Taking the ratio from the asset keeps the box
// matched to the artwork in both cases.
const ASPECT = logoBlack.width / logoBlack.height;
const intrinsicHeight = fluid ? 168 : height;
const intrinsicWidth = Math.round(intrinsicHeight * ASPECT);

const shared = {
  width: intrinsicWidth,
  height: intrinsicHeight,
  densities: [1, 2],
  loading: eager ? ('eager' as const) : ('lazy' as const),
  decoding: 'async' as const,
  class: 'h-full w-auto object-contain',
};
---

<span
  class:list={['inline-block', className]}
  style={fluid ? undefined : `height:${height}px`}
  role={alt ? 'img' : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : 'true'}
>
  <Image src={logoBlack} alt="" {...shared} class:list={[shared.class, 'qa-logo-ink']} />
  <Image src={logoWhite} alt="" {...shared} class:list={[shared.class, 'qa-logo-paper']} />
</span>
