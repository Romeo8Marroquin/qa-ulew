---
import { Icon } from 'astro-icon/components';

import LocalePicker from '~/components/LocalePicker.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import { SITE } from '~/config/site';
import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { localePath, useTranslations } from '~/i18n/utils';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

// The landing is a single page today, so these are in-page anchors. When real
// routes exist, swap the `href` for `localePath('/videos', locale)` etc.
const navItems = [
  { href: '#videos', label: t('nav.videos') },
  { href: '#about', label: t('nav.about') },
  { href: '#contact', label: t('nav.contact') },
];

const home = localePath('/', locale);
---

<header
  class="sticky top-0 z-50 border-b border-border bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="qa-container flex h-16 items-center justify-between gap-4">
    {/* TODO: replace the wordmark with the real logo once it exists. */}
    <a href={home} class="flex items-center gap-2 font-semibold tracking-tight text-fg">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-md bg-brand text-sm font-bold text-brand-fg"
      >
        QU
      </span>
      <span class="text-lg">{SITE.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t('nav.home')}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-fg-muted transition-colors hover:bg-bg-subtle hover:text-fg"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LocalePicker />
      <ThemeToggle />

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="qa-mobile-nav"
        aria-label={t('nav.menu.open')}
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-bg-subtle hover:text-fg md:hidden"
      >
        <Icon name="lucide:menu" class="h-5 w-5" data-menu-icon="open" aria-hidden="true" />
        <Icon name="lucide:x" class="hidden h-5 w-5" data-menu-icon="close" aria-hidden="true" />
      </button>
    </div>
  </div>

  <nav
    id="qa-mobile-nav"
    hidden
    class="border-t border-border bg-bg md:hidden"
    aria-label={t('nav.home')}
  >
    <ul class="qa-container flex flex-col py-2">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-md px-3 py-3 font-medium text-fg-muted transition-colors hover:bg-bg-subtle hover:text-fg"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('#qa-mobile-nav');

  if (toggle && nav) {
    const openIcon = toggle.querySelector<SVGElement>('[data-menu-icon="open"]');
    const closeIcon = toggle.querySelector<SVGElement>('[data-menu-icon="close"]');

    const setOpen = (open: boolean) => {
      nav.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };

    // `hidden` is typed `string | boolean` (it also accepts "until-found"),
    // so normalise before flipping it.
    toggle.addEventListener('click', () => setOpen(Boolean(nav.hidden)));

    // Close after following an in-page anchor.
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Close when resizing up to the desktop breakpoint.
    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
