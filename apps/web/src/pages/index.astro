---
import AdSlot from '~/components/AdSlot.astro';
import ContactMethods from '~/components/ContactMethods.astro';
import Hero from '~/components/Hero.astro';
import Reveal from '~/components/Reveal.astro';
import Section from '~/components/Section.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import VideoList from '~/components/VideoList.astro';
import VideoTemplates from '~/components/VideoTemplates.astro';
import { FEATURED_VIDEOS, activeSocialLinks } from '~/config/site';
import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { fetchVideoCatalog, mergeVideos } from '~/lib/youtube';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

// Build-time only. Falls back to the committed snapshot, and to empty lists if
// the feed is disabled, so a YouTube outage can never fail the deploy — see
// lib/youtube.ts.
const catalog = await fetchVideoCatalog();
const recent = mergeVideos(FEATURED_VIDEOS, catalog.recent);
const { popular } = catalog;

const hasSocial = activeSocialLinks().length > 0;

// Each element the logo actually contains, paired with what it means.
const identity = (['name', 'tower', 'clock', 'date'] as const).map((key) => ({
  label: t(`about.identity.${key}.label`),
  meaning: t(`about.identity.${key}.meaning`),
}));
---

<BaseLayout fullBleed popular={popular.length > 0}>
  <Hero />

  <AdSlot placement="header" height={[100, 90]} />

  {/* --- Videos --- */}
  <Section id="videos" title={t('videos.title')} subtitle={t('videos.subtitle')} muted>
    <VideoList name="recent" videos={recent} meta={['date']} eager />
  </Section>

  {
    /*
      Most viewed. Its own section, so it is its own landmark and its own entry
      in a screen reader's heading list — "lo más visto" is not a part of "lo
      más reciente", and nesting it under that heading would say it was.

      It continues the muted band of the section above rather than starting a
      new surface: the two lists read as one stretch of content, divided by the
      single hairline the section above already draws. Not `muted`, because
      that adds a top border too, and two hairlines stacked read as one heavy
      rule.

      Rendered only when there is something in it. The snapshot means that is
      every real build; a page without one simply has one list.
    */
    popular.length > 0 && (
      <Section
        id="popular"
        title={t('videos.popular.title')}
        subtitle={t('videos.popular.subtitle')}
        class="border-b border-border bg-bg-subtle"
      >
        <VideoList name="popular" videos={popular} meta={['views', 'date']} />
      </Section>
    )
  }

  <VideoTemplates />

  <script>
    import '~/scripts/video-feed';
  </script>

  <AdSlot placement="in-feed" />

  {/* --- About --- */}
  <Section id="about" title={t('about.title')}>
    <div class="max-w-3xl">
      <Reveal>
        <p class="font-display text-2xl leading-snug text-balance text-fg md:text-3xl">
          {t('about.lead')}
        </p>
      </Reveal>
      <Reveal delay={100}>
        <p class="mt-6 text-lg leading-relaxed text-pretty text-fg-muted">
          {t('about.body')}
        </p>
      </Reveal>
    </div>

    {
      /*
      Identity. The logo is dense with meaning that a visitor cannot decode by
      looking at it — a church, a volcano, a date, woven motifs. Naming each one
      turns the mark from decoration into the story it was drawn to tell.

      A <dl> because this is genuinely term/description pairs, not a list of
      links or a table.
    */
    }
    <div class="mt-20 border-t border-border pt-14">
      <Reveal>
        <h3 id="identity-title" class="font-display text-2xl font-semibold text-fg md:text-3xl">
          {t('about.identity.title')}
        </h3>
        <p class="mt-3 max-w-xl text-pretty text-fg-muted">{t('about.identity.intro')}</p>
      </Reveal>

      {
        /*
        `aria-labelledby` on the list itself. The heading above it is a sibling,
        so nothing otherwise connects the two: a screen reader jumping into the
        list by its own navigation lands on "El nombre" with no idea these are
        the parts of a logo.
      */
      }
      <dl aria-labelledby="identity-title" class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {
          identity.map((item, index) => (
            <Reveal delay={(index % 2) * 90}>
              <dt class="text-[0.68rem] font-medium tracking-[0.2em] text-fg-subtle uppercase">
                {item.label}
              </dt>
              <dd class="mt-3 leading-relaxed text-pretty text-fg-muted">{item.meaning}</dd>
            </Reveal>
          ))
        }
      </dl>
    </div>
  </Section>

  {/* --- Social + contact --- */}
  <Section id="contact" title={t('contact.title')} subtitle={t('contact.subtitle')} muted>
    <div class="flex flex-col gap-14">
      <Reveal>
        <ContactMethods />
      </Reveal>

      {
        hasSocial && (
          <Reveal delay={80}>
            <h3 class="text-[0.68rem] font-medium tracking-[0.2em] text-fg-subtle uppercase">
              {t('contact.follow')}
            </h3>
            <SocialLinks variant="labelled" class="mt-5" />
          </Reveal>
        )
      }
    </div>
  </Section>

  <AdSlot placement="footer" />
</BaseLayout>
