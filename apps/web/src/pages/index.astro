---
import AdSlot from '~/components/AdSlot.astro';
import ContactMethods from '~/components/ContactMethods.astro';
import Hero from '~/components/Hero.astro';
import Reveal from '~/components/Reveal.astro';
import Section from '~/components/Section.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import VideoEmbed from '~/components/VideoEmbed.astro';
import { FEATURED_VIDEOS, activeSocialLinks, youtubeFeedEnabled } from '~/config/site';
import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { fetchLatestVideos, mergeVideos } from '~/lib/youtube';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);

// Build-time only. Returns [] if the feed is disabled or unreachable, so a
// YouTube outage can never fail the deploy — see lib/youtube.ts.
const videos = mergeVideos(FEATURED_VIDEOS, await fetchLatestVideos());

const hasSocial = activeSocialLinks().length > 0;

// Each element the logo actually contains, paired with what it means.
const identity = (['name', 'tower', 'clock', 'date'] as const).map((key) => ({
  label: t(`about.identity.${key}.label`),
  meaning: t(`about.identity.${key}.meaning`),
}));
---

<BaseLayout fullBleed>
  <Hero />

  <AdSlot placement="header" height={[100, 90]} />

  {/* --- Videos --- */}
  <Section id="videos" title={t('videos.title')} subtitle={t('videos.subtitle')} muted>
    {
      /*
      The grid and the empty message are both always present, rather than one
      or the other. `scripts/video-feed.ts` refills this grid after load, and
      the case it most needs to handle is a build that shipped no videos at all
      because YouTube was throttling the deploy — which is precisely when the
      old markup rendered the message *instead of* a grid, leaving the script
      nothing to fill.
    */
    }
    <div class="grid gap-x-8 gap-y-12 md:grid-cols-2" data-video-grid>
      {
        videos.map((video, index) => (
          <Reveal delay={(index % 2) * 80}>
            <VideoEmbed
              provider={video.provider}
              id={video.id}
              title={video.title}
              poster={video.poster}
              eager={index === 0}
              embeddable={video.embeddable}
            />
          </Reveal>
        ))
      }
    </div>

    <div data-video-empty hidden={videos.length > 0}>
      <Reveal>
        <p
          class="rounded-lg border border-dashed border-border px-6 py-20 text-center text-fg-subtle"
        >
          {t('videos.empty')}
        </p>
      </Reveal>
    </div>

    {
      /*
        Prototypes for the two tile shapes, rendered by the same component the
        real tiles use so they cannot drift from it. `__ID__` and `__TITLE__`
        are stamped out per video in `scripts/video-feed.ts`.

        Inert until cloned: a browser neither loads the poster nor runs
        anything inside a <template>, and `document.querySelectorAll` does not
        reach into one, so the reveal and facade scripts skip these.
      */
      youtubeFeedEnabled() && (
        <>
          <template data-video-template="embeddable">
            <Reveal>
              <VideoEmbed provider="youtube" id="__ID__" title="__TITLE__" />
            </Reveal>
          </template>
          <template data-video-template="link">
            <Reveal>
              <VideoEmbed provider="youtube" id="__ID__" title="__TITLE__" embeddable={false} />
            </Reveal>
          </template>
        </>
      )
    }
  </Section>

  <script>
    import '~/scripts/video-feed';
  </script>

  <AdSlot placement="in-feed" />

  {/* --- About --- */}
  <Section id="about" title={t('about.title')}>
    <div class="max-w-3xl">
      <Reveal>
        <p class="font-display text-2xl leading-snug text-balance text-fg md:text-3xl">
          {t('about.lead')}
        </p>
      </Reveal>
      <Reveal delay={100}>
        <p class="mt-6 text-lg leading-relaxed text-pretty text-fg-muted">
          {t('about.body')}
        </p>
      </Reveal>
    </div>

    {
      /*
      Identity. The logo is dense with meaning that a visitor cannot decode by
      looking at it — a church, a volcano, a date, woven motifs. Naming each one
      turns the mark from decoration into the story it was drawn to tell.

      A <dl> because this is genuinely term/description pairs, not a list of
      links or a table.
    */
    }
    <div class="mt-20 border-t border-border pt-14">
      <Reveal>
        <h3 id="identity-title" class="font-display text-2xl font-semibold text-fg md:text-3xl">
          {t('about.identity.title')}
        </h3>
        <p class="mt-3 max-w-xl text-pretty text-fg-muted">{t('about.identity.intro')}</p>
      </Reveal>

      {
        /*
        `aria-labelledby` on the list itself. The heading above it is a sibling,
        so nothing otherwise connects the two: a screen reader jumping into the
        list by its own navigation lands on "El nombre" with no idea these are
        the parts of a logo.
      */
      }
      <dl aria-labelledby="identity-title" class="mt-12 grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {
          identity.map((item, index) => (
            <Reveal delay={(index % 2) * 90}>
              <dt class="text-[0.68rem] font-medium tracking-[0.2em] text-fg-subtle uppercase">
                {item.label}
              </dt>
              <dd class="mt-3 leading-relaxed text-pretty text-fg-muted">{item.meaning}</dd>
            </Reveal>
          ))
        }
      </dl>
    </div>
  </Section>

  {/* --- Social + contact --- */}
  <Section id="contact" title={t('contact.title')} subtitle={t('contact.subtitle')} muted>
    <div class="flex flex-col gap-14">
      <Reveal>
        <ContactMethods />
      </Reveal>

      {
        hasSocial && (
          <Reveal delay={80}>
            <h3 class="text-[0.68rem] font-medium tracking-[0.2em] text-fg-subtle uppercase">
              {t('contact.follow')}
            </h3>
            <SocialLinks variant="labelled" class="mt-5" />
          </Reveal>
        )
      }
    </div>
  </Section>

  <AdSlot placement="footer" />
</BaseLayout>
