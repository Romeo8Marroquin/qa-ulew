---
import { Icon } from 'astro-icon/components';

import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { localePath, useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<BaseLayout title={t('404.title')} description={t('404.body')} noindex>
  <div
    class="qa-container flex min-h-[60vh] flex-col items-center justify-center py-20 text-center"
  >
    <p class="font-mono text-6xl font-bold text-brand">404</p>
    <h1 class="mt-6 font-display text-3xl font-bold tracking-tight text-fg md:text-4xl">
      {t('404.title')}
    </h1>
    <p class="mt-4 max-w-md text-lg text-pretty text-fg-muted">{t('404.body')}</p>

    <a
      href={localePath('/', locale)}
      class="mt-10 inline-flex items-center gap-2 rounded-md bg-brand px-6 py-3 font-semibold text-brand-fg transition-colors hover:bg-brand-hover"
    >
      <Icon name="lucide:arrow-right" class="h-4 w-4" aria-hidden="true" />
      {t('404.cta')}
    </a>
  </div>
</BaseLayout>
