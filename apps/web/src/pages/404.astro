---
import { Icon } from 'astro-icon/components';

import { DEFAULT_LOCALE, isLocale } from '~/i18n/config';
import { localePath, useTranslations } from '~/i18n/utils';
import BaseLayout from '~/layouts/BaseLayout.astro';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = useTranslations(locale);
---

<BaseLayout title={t('404.title')} description={t('404.body')} noindex>
  <div
    class="qa-container flex min-h-[70vh] flex-col items-center justify-center py-20 text-center"
  >
    <p class="font-display text-8xl font-semibold text-fg-subtle">404</p>
    <h1 class="mt-6 font-display text-4xl font-semibold tracking-tight text-fg md:text-5xl">
      {t('404.title')}
    </h1>
    <p class="mt-4 max-w-md text-lg text-pretty text-fg-muted">{t('404.body')}</p>

    <a
      href={localePath('/', locale)}
      class="group mt-10 inline-flex items-center gap-2 rounded-md bg-brand px-7 py-3.5 font-semibold text-brand-fg transition-all duration-200 hover:bg-brand-hover hover:shadow-md"
    >
      <Icon
        name="lucide:arrow-right"
        class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
        aria-hidden="true"
      />
      {t('404.cta')}
    </a>
  </div>
</BaseLayout>
