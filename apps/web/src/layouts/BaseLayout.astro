---
import BaseHead from '~/components/BaseHead.astro';
import Footer from '~/components/Footer.astro';
import Header from '~/components/Header.astro';
import Scrollbar from '~/components/Scrollbar.astro';
import { DEFAULT_LOCALE, LOCALE_META, isLocale, type Locale } from '~/i18n/config';
import { useTranslations } from '~/i18n/utils';

// Self-hosted variable fonts. No request to Google, nothing to disclose in a
// privacy policy, and no third-party host that can be slow or go down.
// Only the weight axis is loaded — see the note in global.css.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /**
   * Pages whose first element is a full-bleed hero sit *under* the fixed
   * header. Everything else needs top padding so content is not covered.
   */
  fullBleed?: boolean;
}

const { title, description, image, noindex, fullBleed = false } = Astro.props;

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const meta = LOCALE_META[locale];
const t = useTranslations(locale);
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    {
      /*
      Runs before first paint so the page never flashes the wrong theme.
      `is:inline` keeps it out of the bundle and in the document itself.
      Order matters: this must come before the stylesheet is applied.
    */
    }
    <script is:inline>
      (function () {
        var root = document.documentElement;

        // Suppress transitions until after first paint, so resolving the theme
        // here does not visibly animate from the default palette on every load.
        root.setAttribute('data-booting', '');

        try {
          var stored = localStorage.getItem('qa-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          root.dataset.theme = theme;
        } catch (error) {
          root.dataset.theme = 'light';
        }

        // Two frames: the first paints the resolved theme, the second releases
        // transitions. Releasing after one frame can still catch the paint.
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            root.removeAttribute('data-booting');
          });
        });
      })();
    </script>

    <BaseHead title={title} description={description} image={image} noindex={noindex} />
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#main" class="qa-sr-only">{t('nav.skipToContent')}</a>

    {/* A full-bleed page opens with the dark hero, which the header overlays. */}
    <Header overlay={fullBleed} />

    {
      /*
      `tabindex="-1"` is what makes the skip link above actually work.

      Following a fragment to a non-focusable element moves the browser's
      *scroll* position and its sequential-navigation starting point, but not
      focus — so the next Tab lands wherever the browser guesses, and a screen
      reader keeps reading from where it was. The behaviour differs per browser
      and has done for twenty years. A negative tabindex makes <main> a real
      focus target without putting it in the tab order, which is the fix every
      browser agrees on.

      It never shows a focus ring: focus arrives here by fragment or by script,
      never by keyboard, so `:focus-visible` does not match.
    */
    }
    <main
      id="main"
      tabindex="-1"
      class:list={['flex-1', !fullBleed && 'pt-[var(--qa-header-height)]']}
    >
      <slot />
    </main>

    <Footer />

    <Scrollbar />
  </body>
</html>
